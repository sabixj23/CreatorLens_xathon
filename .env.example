OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Redirect URI to register: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js session encryption. Generate with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Server-side API key for public YouTube Data API v3 calls (building the comparables
# fixture). Separate from the OAuth client — this is not user-scoped.
YOUTUBE_API_KEY=

# Tells the frontend's Connect button to point at the real backend route instead of
# the "not yet available" demo-only messaging. Must be NEXT_PUBLIC_ to reach the client.
NEXT_PUBLIC_CONNECT_PATH=/api/connect
